Description: Hard-code paths to external system run-time dependencies
Author: Tobias Hansen <thansen@debian.org>
Author: Ximin Luo <infinity0@debian.org>
Forwarded: not-needed
---
This patch header follows DEP-3: http://dep.debian.net/deps/dep3/
--- a/sage/src/sage/misc/cython.py
+++ b/sage/src/sage/misc/cython.py
@@ -581,7 +581,7 @@
     extra_sources = []
     for fname in additional_source_files:
         fname = fname.replace("$SAGE_SRC", SAGE_SRC)
-        fname = fname.replace("$SAGE_LOCAL", SAGE_LOCAL)
+        fname = fname.replace("$SAGE_LOCAL", '/usr/include')
         extra_sources.append(fname)
 
     # Add current working directory to includes. This is needed because
--- a/sage/src/sage/libs/lcalc/lcalc_sage.h
+++ b/sage/src/sage/libs/lcalc/lcalc_sage.h
@@ -1,4 +1,4 @@
-#include "libLfunction/L.h"
+#include "Lfunction/L.h"
 
 int *new_ints(int l)
 {
--- a/sage/build/bin/sage-python23
+++ b/sage/build/bin/sage-python23
@@ -12,9 +12,9 @@
 
 
 if [ "$SAGE_PYTHON3" = yes ]; then
-   PYTHON="$SAGE_LOCAL/bin/python3"
+   PYTHON="/usr/bin/python3"
 else
-   PYTHON="$SAGE_LOCAL/bin/python2"
+   PYTHON="/usr/bin/python2"
 fi
 
 # Check that Python is actually installed and issue an error message if not--in
--- a/sage/src/sage/repl/ipython_kernel/install.py
+++ b/sage/src/sage/repl/ipython_kernel/install.py
@@ -196,7 +196,7 @@
              '{connection_file}']
         """
         return [
-            os.path.join(SAGE_LOCAL, 'bin', 'sage'),
+            os.path.join('/usr', 'bin', 'sage'),
             '--python',
             '-m', 'sage.repl.ipython_kernel',
             '-f', '{connection_file}',
