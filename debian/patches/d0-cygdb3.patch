Description: Find cygdb binary
 cygdb is called cygdb3 in Debian.
Author: Tobias Hansen <thansen@debian.org>

Index: sagemath/src/bin/sage
===================================================================
--- sagemath.orig/src/bin/sage
+++ sagemath/src/bin/sage
@@ -1050,7 +1050,7 @@ if [ "$1" = '-gdb' -o "$1" = "--gdb" ];
             -args python "${SELF}-ipython" "$@" -i
     else
         sage_dir=$(python3 -c 'import os, sage; print(os.path.dirname(sage.__file__))')
-        cygdb "$sage_dir" "$SAGE_SRC/sage" \
+        cygdb3 "$sage_dir" "$SAGE_SRC/sage" \
             -- --eval-command "run" \
             -args python "${SELF}-ipython" "$@" -i
     fi
