 import sage.rings.rational
 import sage.rings.integer
 from . import polynomial_ring
@@ -2217,11 +2216,15 @@ cdef class Polynomial(CommutativeAlgebra
             except TypeError:
                 pass
 
-        # Delegate to coercion model. The line below is basically
