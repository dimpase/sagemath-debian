Description: Update doc and copyright paths for Debian package
Author: Tobias Hansen <thansen@debian.org>

Index: sagemath/src/sage/misc/sagedoc.py
===================================================================
--- sagemath.orig/src/sage/misc/sagedoc.py
+++ sagemath/src/sage/misc/sagedoc.py
@@ -1632,8 +1632,8 @@ class _sage_doc:
         url = self._base_url + os.path.join(name, "index.html")
         path = os.path.join(self._base_path, name, "index.html")
         if not os.path.exists(path):
-            raise OSError("""The document '{0}' does not exist.  Please build it
-with 'sage -docbuild {0} html' and try again.""".format(name))
+            raise OSError("""The document '{0}' does not exist.  Please install
+the 'sagemath-doc' package and try again.""".format(name))
 
         if testing:
             return (url, path)
