Description: Find rubiks binaries
 They have different names in Debian.
Author: Tobias Hansen <thansen@debian.org>

--- a/sage/src/sage/features/rubiks.py
+++ b/sage/src/sage/features/rubiks.py
@@ -80,7 +80,7 @@
             sage: isinstance(optimal(), optimal)
             True
         """
-        Executable.__init__(self, "optimal", executable=RUBIKS_BINS_PREFIX + "optimal",
+        Executable.__init__(self, "optimal", executable=RUBIKS_BINS_PREFIX + "rubiks_optimal",
                             spkg="rubiks")
 
 
@@ -124,7 +124,7 @@
             sage: isinstance(dikcube(), dikcube)
             True
         """
-        Executable.__init__(self, "dikcube", executable=RUBIKS_BINS_PREFIX + "dikcube",
+        Executable.__init__(self, "dikcube", executable=RUBIKS_BINS_PREFIX + "rubiks_dikcube",
                             spkg="rubiks")
 
 
@@ -146,7 +146,7 @@
             sage: isinstance(cubex(), cubex)
             True
         """
-        Executable.__init__(self, "cubex", executable=RUBIKS_BINS_PREFIX + "cubex",
+        Executable.__init__(self, "cubex", executable=RUBIKS_BINS_PREFIX + "rubiks_cubex",
                             spkg="rubiks")
 
 
