From 6d7fe919fa405cadb973b187d245855dbec1b0bc Mon Sep 17 00:00:00 2001
From: Tobias Diez <code@tobiasdiez.com>
Date: Sun, 4 May 2025 12:48:52 +0000
Subject: [PATCH] Fix compilation and runtime errors on Fedora 42

---
 src/sage/libs/ecl.pxd | 1 -
 src/sage/libs/ecl.pyx | 2 --
 2 files changed, 3 deletions(-)

Index: sage-test/sage/src/sage/libs/ecl.pxd
===================================================================
--- sage-test.orig/sage/src/sage/libs/ecl.pxd
+++ sage-test/sage/src/sage/libs/ecl.pxd
@@ -89,7 +89,6 @@ cdef extern from "ecl/ecl.h":
     # Type predicates returning a C boolean
 
     bint bint_floatp "floatp" (cl_object x)
-    bint bint_numberp "ecl_numberp" (cl_object x)
     bint bint_eql "ecl_eql"(cl_object x, cl_object y)
     bint bint_equal "ecl_equal"(cl_object x, cl_object y)
     bint bint_equalp "ecl_equalp"(cl_object x, cl_object y)
Index: sage-test/sage/src/sage/libs/ecl.pyx
===================================================================
--- sage-test.orig/sage/src/sage/libs/ecl.pyx
+++ sage-test/sage/src/sage/libs/ecl.pyx
@@ -35,8 +35,6 @@ cdef bint bint_symbolp(cl_object obj):
 #these type predicates are only provided in "cl_*" form, so we wrap them
 #with the proper type cast.
 
-cdef bint bint_numberp(cl_object obj):
-    return not(cl_numberp(obj) == ECL_NIL)
 cdef bint bint_integerp(cl_object obj):
     return not(cl_integerp(obj) == ECL_NIL)
 cdef bint bint_rationalp(cl_object obj):
