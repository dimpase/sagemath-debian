    'combinatorial_designs': @HAS_COMBINATORIAL_DESIGNS@,
    'conway_polynomials': @HAS_CONWAY_POLYNOMIALS@,
    'cvxopt': @HAS_CVXOPT@,
    'cython': @HAS_CYTHON@,
    'dateutil': @HAS_DATEUTIL@,
    'docutils': @HAS_DOCUTILS@,
    'ecl': @HAS_ECL@,
    'eclib': @HAS_ECLIB@,
    'ecm': @HAS_ECM@,
    'elliptic_curves': @HAS_ELLIPTIC_CURVES@,
