# Installing these scripts somewhere else than in /usr/bin
# is currently not supported by upstream and would cause a
# lot of complexity in packaging.
# This is mentioned in https://trac.sagemath.org/ticket/22731
sagemath: executable-not-elf-or-script usr/bin/*
sagemath: no-manual-page usr/bin/*
sagemath: script-with-language-extension usr/bin/*
