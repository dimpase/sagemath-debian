#!/usr/bin/make -f

VERSION := $(shell dpkg-parsechangelog -S Version| sed 's@\(.\+\)-.\+@\1@')

ifneq (,$(filter parallel=%,$(DEB_BUILD_OPTIONS)))
	NUMJOBS = $(patsubst parallel=%,%,$(filter parallel=%,$(DEB_BUILD_OPTIONS)))
	export MAKE = make -j$(NUMJOBS)
else
	export MAKE = make -j5
endif


%:
	dh $@ --parallel

override_dh_auto_build: prune
	$(MAKE) --directory=sage build

override_dh_auto_test: ptestlong

override_dh_auto_install:

get-orig-source:
	cd sage && git archive --prefix=sagemath_$(VERSION)/sage/ --format=tar HEAD | xz -zf > ../../sagemath_$(VERSION).orig.tar.xz

prune:
	cd debian/pruner && autoconf
	cd debian/pruner && ./configure --with-sage-root="$(shell pwd)/sage"
	cd sage && python ../debian/pruner/pruner.py
	touch prune

ptestlong:
	cd sage && local/bin/sage-starts
	cd sage && ./sage -t -p --all --long --logfile=logs/ptestlong.log

reset:
	$(MAKE) -f debian/rules clean
	QUILT_PATCHES=debian/patches quilt pop -af || true
	cd sage; git clean -fdx
	rm -rf $HOME/.sage/
	QUILT_PATCHES=debian/patches quilt push -a
