#!/usr/bin/python3
import sage.all  # Initialize Sage before importing its embedded Maxima interface.
from cysignals.tests import interrupt_after_delay
from sage.libs.ecl import ecl_eval
from sage.interfaces.maxima_lib import maxima_lib

assert ecl_eval("(+ 40 2)").python() == 42
assert maxima_lib("integrate(x,x)-x^2/2").sage() == 0
assert maxima_lib("determinant(matrix([1,2],[3,8]))").sage() == 2

ecl_eval("(defun debian-test-infinite () (loop))")
interrupt_after_delay(100)
try:
    ecl_eval("(debian-test-infinite)")
except KeyboardInterrupt:
    pass
else:
    raise AssertionError("ECL did not report KeyboardInterrupt")

assert ecl_eval("(+ 40 2)").python() == 42
print("ECL evaluation, interrupts, and embedded Maxima passed")
