Test-Command: mkdir -p $HOME/.sage && OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 LANG=C.UTF-8 SAGE_LOCAL=/usr SAGE_DOC=$(pwd)/src/doc SAGE_SRC=$(pwd)/src python3 -m sage.doctest -p --logfile=ptestlong.log src/sage || make -s --no-print-directory -f debian/tests.mk MAX_TEST_FAILURES=1000 had-few-failures
Depends: sagemath-jupyter, sagemath-doc, python3-pytest, make
Restrictions: rw-build-tree, allow-stderr
